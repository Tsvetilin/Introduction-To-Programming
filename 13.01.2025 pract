void sort(int* array, int size)
{
	for (size_t i = 0; i < size-1; i++)
	{
		int minIndex = i;
		for (size_t j = 1; j < size; j++)
		{
			minIndex = array[minIndex] < array[j] ? minIndex : j;
		}
		std::swap(array[i], array[minIndex]);
	}
}

bool binarySearch(int* array,int sizeArr, int number)
{
	int middle = *(array + sizeArr / 2);
	if (middle == number) return true;
	if (sizeArr < 1) return false;

	if(number<middle) return binarySearch(array, sizeArr/2, 4);
	if (number > middle) return binarySearch(array+ sizeArr / 2, sizeArr / 2, 4);


}

